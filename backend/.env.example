# ==============================================================================
# WEENGINEERS TECH — Backend Environment Configuration Example
# ==============================================================================

# Server Port (Render sets this dynamically in production; local default is 5000)
PORT=5000

# Application Environment: 'production' or 'development'
NODE_ENV=production

# MongoDB Atlas Connection URI
# Example Atlas format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/weengineers?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/weengineers?retryWrites=true&w=majority

# JWT Signing Secret (Generate a strong 32+ character random string for production)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_min_32_chars

# JWT Validity Duration
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins for CORS (Your deployed Vercel URL and custom domain if applicable)
# Supports comma-separated list: e.g. https://weengineers.vercel.app,https://weengineers.tech
FRONTEND_URL=https://your-frontend-app.vercel.app
CORS_ORIGIN=https://your-frontend-app.vercel.app

# Optional Seed Credentials (Used only when executing 'npm run seed' manually)
INITIAL_FOUNDER_EMAIL=founder@weengineers.tech
INITIAL_FOUNDER_PASSWORD=replace_with_secure_initial_founder_password
INITIAL_FOUNDER_NAME=Founder
